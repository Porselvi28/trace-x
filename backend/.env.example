# TRACE X Forensic Platform Configuration
PROJECT_NAME="TRACE X — Digital Evidence Intelligence"
VERSION="1.0.0"
API_V1_STR="/api"

# Security
SECRET_KEY="tracex-forensic-dev-super-secure-jwt-secret-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL="sqlite:///./data/tracex.db"

# Storage
STORAGE_DIR="./data"
EVIDENCE_DIR="./data/evidence"
FRAMES_DIR="./data/frames"
REPORTS_DIR="./data/reports"
MAX_UPLOAD_SIZE_MB=500

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
